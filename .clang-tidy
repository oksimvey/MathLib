Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  portability-*,
  misc-*

WarningsAsErrors: ""

HeaderFilterRegex: ".*"

AnalyzeTemporaryDtors: true

FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.VariableCase
    value: camelCase

  - key: readability-identifier-naming.FunctionCase
    value: camelCase

  - key: modernize-use-nullptr.NullMacros
    value: NULL

  - key: modernize-loop-convert.MinConfidence
    value: reasonable
    